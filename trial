/*==========================================================
  LIFTLOG PREMIUM LANDING PAGE
==========================================================*/

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,
body{
    width:100%;
    height:100%;
    overflow:hidden;
    background:#000;
    font-family:"Inter",sans-serif;
}

:root{
    --primary-gradient:linear-gradient(135deg,#5D8CFF,#7A5AF8);
}

.landing{
    position:relative;
    width:100%;
    height:100vh;
    overflow:hidden;
}

/*==========================================================
  BACKGROUND IMAGE
==========================================================*/

.hero-image{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
}

/*==========================================================
  OVERLAY
==========================================================*/

.overlay{
    position:absolute;
    inset:0;
    background:
    linear-gradient(
        180deg,
        rgba(0,0,0,.08) 0%,
        rgba(0,0,0,.18) 25%,
        rgba(0,0,0,.45) 55%,
        rgba(0,0,0,.92) 100%
    );
}

/*==========================================================
  LOGO
==========================================================*/

.logo{
    position:absolute;
    top:55px;
    left:30px;

    display:flex;
    align-items:center;
    gap:12px;

    z-index:20;

    color:#fff;
    font-size:1.45rem;
    font-weight:700;
    font-family:"Poppins",sans-serif;
}

.logo i{
    font-size:30px;
    color:#6EA2FF;
}

/*==========================================================
  CONTENT
==========================================================*/

.hero-content{
    position:absolute;
    left:30px;
    right:30px;
    bottom:55px;
    z-index:30;
}

/*==========================================================
  BADGE
==========================================================*/

.hero-badge{

    display:inline-flex;
    align-items:center;

    padding:11px 18px;

    border-radius:999px;

    margin-bottom:24px;

    font-size:.72rem;
    font-weight:700;
    letter-spacing:2px;
    text-transform:uppercase;

    color:#fff;

    background:
        linear-gradient(
            135deg,
            rgba(93,140,255,.18),
            rgba(122,90,248,.18)
        );

    backdrop-filter:blur(22px);
    -webkit-backdrop-filter:blur(22px);

    border:1px solid rgba(255,255,255,.10);

    box-shadow:
        0 8px 24px rgba(93,140,255,.15);
}

/*==========================================================
  TITLE
==========================================================*/

.hero-content h1{

    font-family:"Poppins",sans-serif;

    font-size:4rem;
    font-weight:800;

    line-height:.95;
    letter-spacing:-3px;

    color:#fff;

    margin-bottom:20px;
}

.hero-content p{

    max-width:360px;

    font-size:1.05rem;
    line-height:1.8;

    color:rgba(255,255,255,.82);
}

/*==========================================================
  BUTTON
==========================================================*/

.hero-btn{

    width:100%;

    margin-top:42px;

    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:18px 20px 18px 26px;

    border-radius:999px;

    background:#fff;

    color:#111;

    text-decoration:none;

    font-size:16px;
    font-weight:700;

    box-shadow:
        0 20px 60px rgba(0,0,0,.22);

    transition:.35s ease;
}

.hero-btn:hover{

    transform:translateY(-4px);

    box-shadow:
        0 28px 80px rgba(0,0,0,.28);
}

.hero-btn span{
    white-space:nowrap;
}

.hero-btn-icon{

    width:48px;
    height:48px;

    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    background:var(--primary-gradient);

    color:#fff;

    overflow:hidden;
}

.hero-btn-icon i{

    font-size:16px;

    animation:chevronMove 1.4s infinite ease-in-out;
}

/*==========================================================
  ANIMATION
==========================================================*/

@keyframes chevronMove{

    0%{
        transform:translateX(0);
        opacity:1;
    }

    35%{
        transform:translateX(6px);
        opacity:1;
    }

    60%{
        transform:translateX(2px);
        opacity:.95;
    }

    100%{
        transform:translateX(0);
        opacity:1;
    }

}

/*==========================================================
  MOBILE
==========================================================*/

@media(max-width:768px){

    .logo{
        top:42px;
        left:22px;
        font-size:1.2rem;
    }

    .logo i{
        font-size:26px;
    }

    .hero-content{
        left:22px;
        right:22px;
        bottom:34px;
    }

    .hero-badge{
        padding:9px 16px;
        font-size:.65rem;
        margin-bottom:20px;
    }

    .hero-content h1{
        font-size:3rem;
        letter-spacing:-2px;
    }

    .hero-content p{
        max-width:100%;
        font-size:.95rem;
        line-height:1.75;
    }

    .hero-btn{
        margin-top:36px;
        height:62px;
        padding:0 18px 0 22px;
        font-size:15px;
    }

    .hero-btn-icon{
        width:44px;
        height:44px;
    }
}

@media(max-width:420px){

    .hero-content h1{
        font-size:2.5rem;
    }

    .hero-content p{
        font-size:.9rem;
    }

    .hero-btn{
        height:58px;
        font-size:14px;
    }

    .hero-btn-icon{
        width:40px;
        height:40px;
    }
}