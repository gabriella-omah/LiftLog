/*==========================================================
   LIFTLOG PREMIUM LANDING
   Part 1
==========================================================*/

*,
*::before,
*::after{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{

    --primary:#5D8CFF;
    --secondary:#7A5AF8;

    --gradient:
        linear-gradient(
            135deg,
            #5D8CFF,
            #7A5AF8
        );

    --text:#FFFFFF;

    --text-light:
        rgba(255,255,255,.82);

    --glass:
        rgba(255,255,255,.08);

    --glass-border:
        rgba(255,255,255,.12);

    --transition:
        .35s cubic-bezier(.4,0,.2,1);

}

html,
body{

    width:100%;
    height:100%;

    background:#090B10;

    overflow:hidden;

    font-family:
        "Inter",
        sans-serif;

    -webkit-font-smoothing:antialiased;

}

/*==========================================================
   LANDING SHELL
==========================================================*/

.landing {
    position:relative;

    width:100%;
    height:100vh;
    height:100dvh;

    overflow:hidden;

    isolation:isolate;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  transform: scale(1.02);
}

/* Soft vignette + brand-tinted depth */
.overlay {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      ellipse 90% 55% at 50% 0%,
      rgba(93, 140, 255, 0.14) 0%,
      transparent 55%
    ),
    linear-gradient(
      180deg,
      rgba(9, 11, 16, 0.08) 0%,
      rgba(9, 11, 16, 0.18) 28%,
      rgba(9, 11, 16, 0.55) 58%,
      rgba(9, 11, 16, 0.92) 82%,
      rgba(9, 11, 16, 0.98) 100%
    );
  pointer-events: none;
}

/* Subtle ambient glow behind content */
.landing::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -40px;
  transform: translateX(-50%);
  width: min(520px, 90vw);
  height: 280px;
  background: radial-gradient(
    ellipse,
    rgba(93, 140, 255, 0.18) 0%,
    rgba(122, 90, 248, 0.08) 40%,
    transparent 70%
  );
  filter: blur(40px);
  pointer-events: none;
  z-index: 2;
}

/*==========================================================
   CONTENT
==========================================================*/

.hero-content {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 48px 40px 44px;
}

/* Logo */
.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: "Poppins", sans-serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
  margin-bottom: 56px;
  text-decoration: none;
}

.logo i {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: var(--primary-gradient);
  color: #fff;
  font-size: 20px;
  box-shadow:
    0 8px 24px rgba(93, 140, 255, 0.4),
    0 0 0 1px rgba(255, 255, 255, 0.1);
}

/* Badge */
.hero-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 8px;
  padding: 10px 18px;
  border-radius: 999px;
  background: var(--glass);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  margin-bottom: 22px;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
}

.hero-badge::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--primary-gradient);
  box-shadow: 0 0 10px rgba(93, 140, 255, 0.7);
  flex-shrink: 0;
}

/* Headline */
.hero-content h1 {
  font-family: "Poppins", sans-serif;
  color: #fff;
  font-size: clamp(2.6rem, 6vw, 4.1rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.04em;
  max-width: 520px;
  margin-bottom: 18px;
  text-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
}

/* Supporting copy */
.hero-content p {
  max-width: 420px;
  color: var(--text-muted);
  font-size: 1.05rem;
  line-height: 1.75;
  margin-bottom: 36px;
  font-weight: 450;
}

.bottom-area {
  width: 100%;
  max-width: 480px;
}

/*==========================================================
   CTA BUTTON
==========================================================*/

.hero-btn {
  position: relative;
  width: 100%;
  height: 68px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px 0 28px;
  background: #fff;
  color: #10131A;
  border-radius: 999px;
  text-decoration: none;
  font-family: "Poppins", sans-serif;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.01em;
  box-shadow:
    0 4px 16px rgba(0, 0, 0, 0.18),
    0 20px 50px rgba(0, 0, 0, 0.28),
    0 0 0 1px rgba(255, 255, 255, 0.08);
  transition: var(--transition);
  overflow: hidden;
}

/* Soft sheen */
.hero-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 999px;
  background: linear-gradient(
    105deg,
    rgba(255, 255, 255, 0.55) 0%,
    transparent 42%,
    transparent 58%,
    rgba(255, 255, 255, 0.15) 100%
  );
  pointer-events: none;
}

.hero-btn:hover {
  transform: translateY(-4px);
  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.2),
    0 28px 64px rgba(0, 0, 0, 0.35),
    0 0 0 1px rgba(255, 255, 255, 0.1);
}

.hero-btn:active {
  transform: scale(0.985);
}

.hero-btn span {
  position: relative;
  z-index: 1;
}

/* Icon circle */
.hero-btn-icon {
  position: relative;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow:
    0 8px 22px rgba(93, 140, 255, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
  transition: var(--transition);
  z-index: 1;
}

.hero-btn-icon i {
  color: #fff;
  font-size: 15px;
  z-index: 2;
}

.hero-btn:hover .hero-btn-icon {
  transform: translateX(5px);
  box-shadow:
    0 12px 28px rgba(93, 140, 255, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

/* Ripple rings */
.hero-btn-icon::before,
.hero-btn-icon::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1.5px solid rgba(93, 140, 255, 0.35);
  animation: ripple 2.4s ease-out infinite;
}

.hero-btn-icon::after {
  animation-delay: 1.2s;
}

@keyframes ripple {
  from {
    transform: scale(1);
    opacity: 0.55;
  }
  to {
    transform: scale(1.85);
    opacity: 0;
  }
}

/*==========================================================
   TABLET
==========================================================*/

@media (max-width: 900px) {
  .hero-content {
    padding: 36px 28px 36px;
  }

  .logo {
    margin-bottom: 40px;
    font-size: 1.25rem;
  }

  .logo i {
    width: 38px;
    height: 38px;
    font-size: 18px;
    border-radius: 12px;
  }

  .hero-badge {
    font-size: 0.64rem;
    padding: 9px 15px;
    margin-bottom: 16px;
  }

  .hero-content h1 {
    font-size: clamp(2.4rem, 7vw, 3.2rem);
    margin-bottom: 14px;
  }

  .hero-content p {
    font-size: 0.98rem;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .hero-btn {
    height: 62px;
    font-size: 15px;
    padding: 0 10px 0 24px;
  }

  .hero-btn-icon {
    width: 46px;
    height: 46px;
  }
}

/*==========================================================
   PHONE
==========================================================*/

@media (max-width: 480px) {
  .hero-content {
    padding: 28px 22px 28px;
    justify-content: space-between;
  }

  .logo {
    margin-bottom: 0;
    font-size: 1.15rem;
  }

  .logo i {
    width: 36px;
    height: 36px;
    font-size: 16px;
    border-radius: 11px;
  }

  .hero-badge {
    font-size: 0.58rem;
    letter-spacing: 1.4px;
    padding: 8px 14px;
    margin-bottom: 14px;
  }

  .hero-content h1 {
    font-size: 2.35rem;
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: 12px;
  }

  .hero-content p {
    max-width: 100%;
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 22px;
  }

  .bottom-area {
    max-width: 100%;
  }

  .hero-btn {
    height: 58px;
    font-size: 14.5px;
    padding: 0 8px 0 22px;
  }

  .hero-btn-icon {
    width: 44px;
    height: 44px;
  }

